<?xml version="1.0"?>
<robot name="rover_bot">

    <!-- Colors -->
    <material name="grey">
        <color rgba="0.5 0.5 0.5 1" />
    </material>

    <material name="red">
        <color rgba="1 0 0 1" />
    </material>

    <!-- Base Link -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.07" />
            <geometry>
                <box size="0.5 0.3 0.1" />
            </geometry>
            <material name="grey" />
        </visual>
    </link>

    <!-- Left Wheel -->
    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.07" length="0.02" />
            </geometry>
            <material name="red" />
        </visual>
    </link>

    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel" />
        <origin xyz="0.2 0.16 0.07" rpy="1.57 1.57 0" />
        <axis xyz="0 0 1" />
    </joint>

    <!-- Right Wheel -->
    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.07" length="0.02" />
            </geometry>
            <material name="red" />
        </visual>
    </link>

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel" />
        <origin xyz="0.2 -0.16 0.07" rpy="1.57 1.57 0" />
        <axis xyz="0 0 1" />
    </joint>

    <!-- Caster Wheel -->
    <link name="caster_wheel">
        <visual>
            <geometry>
                <sphere radius="0.05" />
            </geometry>
            <material name="red" />
        </visual>
    </link>

    <joint name="caster_joint" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel" />
        <origin xyz="-0.2 0 0.05" />
    </joint>

</robot>