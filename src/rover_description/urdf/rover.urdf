<?xml version="1.0"?>
<robot name="rover_bot">

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.5 0.3 0.1"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
    </visual>
  </link>

  <!-- Dummy Link -->
  <link name="dummy_link"/>

  <!-- Fixed Joint -->
  <joint name="base_to_dummy" type="fixed">
    <parent link="base_link"/>
    <child link="dummy_link"/>
    <origin xyz="0 0 0"/>
  </joint>

</robot>